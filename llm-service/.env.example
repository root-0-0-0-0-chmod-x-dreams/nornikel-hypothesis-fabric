# ============================================================
# Yandex AI Studio — опционально (рекомендуется как primary)
# ============================================================
YANDEX_FOLDER_ID=<идентификатор_каталога>
YANDEX_API_KEY=<значение_API-ключа>

# ============================================================
# Yandex — опционально
# ============================================================
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# ============================================================
# DeepSeek — fallback (достаточно только API-ключа)
# ============================================================
DEEPSEEK_API_KEY=<deepseek_api_key>
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

DEFAULT_MODEL=aliceai-llm
MODEL_TIMEOUT=120
MODEL_MAX_RETRIES=3

# ============================================================
# Очередь запросов и конкурентность
# ============================================================
MAX_CONCURRENT_REQUESTS=10
QUEUE_MAX_SIZE=1000
REQUEST_TIMEOUT_SECONDS=300

# ============================================================
# Логирование: уровень (DEBUG|INFO|WARNING|ERROR), формат (json|plain)
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================
# Health-check и кэш моделей
# ============================================================
HEALTH_CHECK_INTERVAL=60
MODELS_CACHE_TTL=300

# ============================================================
# FastAPI
# ============================================================
HOST=0.0.0.0
PORT=8000
