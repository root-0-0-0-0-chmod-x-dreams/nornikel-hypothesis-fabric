# RabbitMQ
RABBITMQ_URL=amqp://hypothesis:hypothesis2026@localhost:5672/
RABBITMQ_EXCHANGE=hypothesis.factory

# Vector store
VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hypothesis_text_chunks

# Graph (networkx in worker; neo4j for nl_cypher / ask_graph)
GRAPH_BACKEND=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=hypothesis2026

# Case data root (Excel + chunked books). Usually leave unset — auto-picks bundled data/case.
# Must point to a directory that contains: Пример 1–4/ and Дополнительные материалы/md/
#
# Default (after git pull, no override needed):
#   graphrag-service/data/case
#
# Explicit bundled path:
# GRAPHRAG_DATA_ROOT=/path/to/graphrag-service/data/case
#
# Local hackathon case folder:
# GRAPHRAG_DATA_ROOT=/path/to/Задача 1. Фабрика гипотез/Задача 1
#
# Monolithic MD source is always graphrag-service/data/literature (not this variable).
# Refresh bundled data: make sync-data && make bootstrap
