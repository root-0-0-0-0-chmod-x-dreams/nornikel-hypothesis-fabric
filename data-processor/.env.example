# ============================================================
# Data Processor — конфигурация
# ============================================================

# FastAPI
HOST=0.0.0.0
PORT=8001

# Директории
IMAGES_DIR=/app/images
UPLOADS_DIR=/app/uploads
OUTPUT_DIR=/app/output

# Ограничения
MAX_FILE_SIZE_MB=100
CLEANUP_TEMP_AFTER_MINUTES=60

# Логирование: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================================
# PDF — выбор библиотеки распознавания
# PDF_LIBRARY: "opendataloader" (быстрый, Java-based) или "pymupdf" (лёгкий, Python-only)
# PDF_IMAGE_OUTPUT: "off" (без картинок), "external" (файлы рядом), "embedded" (base64 в markdown)
#   Для opendataloader доступны все три режима.
#   Для pymupdf: "off" или "external".
# PDF_IMAGE_FORMAT: "jpeg" или "png"
# ============================================================
PDF_LIBRARY=opendataloader
PDF_IMAGE_OUTPUT=external
PDF_IMAGE_FORMAT=jpeg

# ============================================================
# OpenDataLoader Hybrid (только для pdf_library=opendataloader)
# Требует запущенный opendataloader-pdf-hybrid сервер.
#   pip install "opendataloader-pdf[hybrid]"
#   opendataloader-pdf-hybrid --port 5002 --force-ocr
# ============================================================
PDF_HYBRID_ENABLED=false
PDF_HYBRID_BACKEND=docling-fast
PDF_HYBRID_URL=http://localhost:5002
PDF_HYBRID_MODE=auto

# ============================================================
# OCR — распознавание текста на извлечённых картинках
# OCR_ENABLED: true/false — после каждой картинки вставляется блок {OCR: ...}
# OCR_LANGUAGES: языки через запятую (ru,en,ja,ch_sim,...)
# OCR_GPU_ENABLED: использовать GPU для EasyOCR (true/false)
#   Требуется CUDA Toolkit + PyTorch с CUDA при GPU=true.
#   Установка EasyOCR: pip install easyocr
# ============================================================
OCR_ENABLED=false
OCR_LANGUAGES=ru,en
OCR_GPU_ENABLED=true
