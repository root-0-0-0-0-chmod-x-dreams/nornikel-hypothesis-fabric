# ============================================================
# Data Processor — конфигурация
# ============================================================

# FastAPI
HOST=0.0.0.0
PORT=8001

# Директории
IMAGES_DIR=/app/images
UPLOADS_DIR=/app/uploads
OUTPUT_DIR=/app/output

# Ограничения
MAX_FILE_SIZE_MB=100
CLEANUP_TEMP_AFTER_MINUTES=60

# Логирование: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
